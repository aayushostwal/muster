#!/usr/bin/env bash
#
# musterctl — operate a Muster install (backend service, postgres+frontend
# containers, database). See docs/OPERATIONS.md for the full reference.
#
# Canonical data/config root: ~/.muster (matches scripts/install.sh).
set -euo pipefail

MUSTER_HOME="${MUSTER_HOME:-$HOME/.muster}"
APP_DIR="$MUSTER_HOME/app"
VENV_DIR="$MUSTER_HOME/venv"
BACKEND_DIR="$APP_DIR/backend"
ENV_FILE="$MUSTER_HOME/muster.env"

installed_value() {
  local key="$1"
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1
}

if [ -n "${MUSTER_COMPOSE_FILE:-}" ]; then
  COMPOSE_FILE="$MUSTER_COMPOSE_FILE"
elif [ -f "$APP_DIR/docker-compose.yml" ]; then
  COMPOSE_FILE="$APP_DIR/docker-compose.yml"
else
  # Backward compatibility for installations made by older installers.
  COMPOSE_FILE="$MUSTER_HOME/docker-compose.yml"
fi

POSTGRES_USER="${MUSTER_POSTGRES_USER:-$(installed_value MUSTER_POSTGRES_USER)}"
POSTGRES_USER="${POSTGRES_USER:-muster}"
POSTGRES_DB="${MUSTER_POSTGRES_DB:-$(installed_value MUSTER_POSTGRES_DB)}"
POSTGRES_DB="${POSTGRES_DB:-muster}"
POSTGRES_HOST="${MUSTER_POSTGRES_HOST:-$(installed_value MUSTER_POSTGRES_HOST)}"
POSTGRES_HOST="${POSTGRES_HOST:-localhost}"
POSTGRES_PASSWORD="${MUSTER_POSTGRES_PASSWORD:-$(installed_value MUSTER_POSTGRES_PASSWORD)}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-muster}"
BACKEND_PORT="${MUSTER_BACKEND_PORT:-$(installed_value MUSTER_BACKEND_PORT)}"
BACKEND_PORT="${BACKEND_PORT:-8080}"
FRONTEND_PORT="${MUSTER_FRONTEND_PORT:-$(installed_value MUSTER_FRONTEND_PORT)}"
FRONTEND_PORT="${FRONTEND_PORT:-3000}"
POSTGRES_PORT="${MUSTER_POSTGRES_PORT:-$(installed_value MUSTER_POSTGRES_PORT)}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"
API_URL="${MUSTER_API_URL:-http://localhost:$BACKEND_PORT}"

info()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m==> WARNING:\033[0m %s\n' "$*" >&2; }
error() { printf '\033[1;31m==> ERROR:\033[0m %s\n' "$*" >&2; }
die()   { error "$*"; exit 1; }

# ---------------------------------------------------------------------------
# Platform detection — branches service-management calls (launchctl vs
# systemctl --user), matching scripts/install.sh's service install.
# ---------------------------------------------------------------------------
case "$(uname -s)" in
  Darwin) MUSTER_OS="darwin" ;;
  Linux)  MUSTER_OS="linux" ;;
  *) die "Unsupported OS: $(uname -s)" ;;
esac

LAUNCHD_LABEL="com.muster.backend"
LAUNCHD_PLIST="$HOME/Library/LaunchAgents/${LAUNCHD_LABEL}.plist"
LAUNCHD_LOG="$HOME/Library/Logs/muster/backend.log"
SYSTEMD_UNIT="muster.service"

compose() {
  [ -f "$COMPOSE_FILE" ] || die "No docker-compose.yml at $COMPOSE_FILE — is Muster installed? Run: musterctl install"
  (
    cd "$(dirname "$COMPOSE_FILE")"
    env \
      "MUSTER_POSTGRES_PORT=$POSTGRES_PORT" \
      "MUSTER_POSTGRES_USER=$POSTGRES_USER" \
      "MUSTER_POSTGRES_PASSWORD=$POSTGRES_PASSWORD" \
      "MUSTER_POSTGRES_DB=$POSTGRES_DB" \
      "MUSTER_FRONTEND_PORT=$FRONTEND_PORT" \
      "MUSTER_API_URL=$API_URL" \
      docker compose --project-name muster -f "$COMPOSE_FILE" "$@"
  )
}

# ---------------------------------------------------------------------------
# Backend service control
# ---------------------------------------------------------------------------
backend_start() {
  if [ "$MUSTER_OS" = "darwin" ]; then
    [ -f "$LAUNCHD_PLIST" ] || die "launchd plist not found at $LAUNCHD_PLIST — run: musterctl install"
    launchctl load -w "$LAUNCHD_PLIST" 2>/dev/null || true
    launchctl kickstart -k "gui/$(id -u)/${LAUNCHD_LABEL}" 2>/dev/null || true
  else
    systemctl --user start "$SYSTEMD_UNIT"
  fi
}

backend_stop() {
  if [ "$MUSTER_OS" = "darwin" ]; then
    launchctl unload -w "$LAUNCHD_PLIST" 2>/dev/null || true
  else
    systemctl --user stop "$SYSTEMD_UNIT" 2>/dev/null || true
  fi
}

backend_restart() {
  if [ "$MUSTER_OS" = "darwin" ]; then
    backend_stop
    backend_start
  else
    systemctl --user restart "$SYSTEMD_UNIT"
  fi
}

backend_status() {
  if [ "$MUSTER_OS" = "darwin" ]; then
    if launchctl list "$LAUNCHD_LABEL" >/dev/null 2>&1; then
      echo "backend (launchd): loaded"
    else
      echo "backend (launchd): not loaded"
    fi
  else
    systemctl --user is-active "$SYSTEMD_UNIT" 2>/dev/null | sed 's/^/backend (systemd): /' || echo "backend (systemd): inactive"
  fi
}

backend_logs() {
  local follow="$1"
  if [ "$MUSTER_OS" = "darwin" ]; then
    [ -f "$LAUNCHD_LOG" ] || die "No log file at $LAUNCHD_LOG yet."
    if [ "$follow" = "1" ]; then tail -f "$LAUNCHD_LOG"; else tail -n 200 "$LAUNCHD_LOG"; fi
  else
    if [ "$follow" = "1" ]; then journalctl --user -u "$SYSTEMD_UNIT" -f; else journalctl --user -u "$SYSTEMD_UNIT" -n 200 --no-pager; fi
  fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_install() {
  local installer="$APP_DIR/scripts/install.sh"
  if [ -f "$installer" ]; then
    exec bash "$installer" "$@"
  else
    die "musterctl is installed but $APP_DIR is missing. Re-run the bootstrap installer: curl -fsSL https://raw.githubusercontent.com/aayushostwal/muster/main/scripts/install.sh | bash"
  fi
}

cmd_start() {
  info "Starting backend..."
  backend_start
  info "Starting postgres + frontend..."
  compose up -d postgres frontend
  info "Muster started."
}

cmd_stop() {
  info "Stopping backend..."
  backend_stop
  info "Stopping postgres + frontend..."
  compose stop
  info "Muster stopped."
}

cmd_restart() {
  info "Restarting backend..."
  backend_restart
  info "Restarting postgres + frontend..."
  compose restart
  info "Muster restarted."
}

cmd_status() {
  echo "--- backend ---"
  backend_status
  echo "--- containers ---"
  compose ps
}

cmd_logs() {
  local target="${1:-all}"
  local follow="0"
  shift || true
  for arg in "$@"; do
    [ "$arg" = "-f" ] && follow="1"
  done

  case "$target" in
    backend) backend_logs "$follow" ;;
    frontend)
      if [ "$follow" = "1" ]; then compose logs -f frontend; else compose logs --tail=200 frontend; fi
      ;;
    postgres)
      if [ "$follow" = "1" ]; then compose logs -f postgres; else compose logs --tail=200 postgres; fi
      ;;
    all)
      echo "--- backend ---"
      backend_logs "0"
      echo "--- containers ---"
      if [ "$follow" = "1" ]; then compose logs -f; else compose logs --tail=200; fi
      ;;
    *) die "Unknown log target: $target (expected backend|frontend|postgres|all)" ;;
  esac
}

cmd_upgrade() {
  info "Pulling latest source..."
  if [ -d "$APP_DIR/.git" ]; then
    git -C "$APP_DIR" pull --ff-only
  else
    warn "No git checkout at $APP_DIR — skipping source update. Re-run the installer to refresh from a release."
  fi

  info "Reinstalling backend deps..."
  "$VENV_DIR/bin/pip" install -r "$BACKEND_DIR/requirements.txt"

  info "Running alembic upgrade head..."
  (
    cd "$BACKEND_DIR"
    env \
      "MUSTER_POSTGRES_HOST=$POSTGRES_HOST" \
      "MUSTER_POSTGRES_PORT=$POSTGRES_PORT" \
      "MUSTER_POSTGRES_USER=$POSTGRES_USER" \
      "MUSTER_POSTGRES_PASSWORD=$POSTGRES_PASSWORD" \
      "MUSTER_POSTGRES_DB=$POSTGRES_DB" \
      "$VENV_DIR/bin/python" -m alembic upgrade head
  )

  info "Pulling + restarting containers..."
  compose pull postgres
  compose up -d --build postgres frontend

  info "Restarting backend service..."
  backend_restart

  info "Upgrade complete. No data was touched."
}

cmd_uninstall() {
  local purge="0" assume_yes="0"
  for arg in "$@"; do
    case "$arg" in
      --purge) purge="1" ;;
      --yes) assume_yes="1" ;;
    esac
  done

  info "Stopping backend..."
  backend_stop
  info "Removing backend service files..."
  if [ "$MUSTER_OS" = "darwin" ]; then
    rm -f "$LAUNCHD_PLIST"
  else
    systemctl --user disable "$SYSTEMD_UNIT" 2>/dev/null || true
    rm -f "$HOME/.config/systemd/user/${SYSTEMD_UNIT}"
    systemctl --user daemon-reload 2>/dev/null || true
  fi

  info "Stopping + removing containers..."
  compose down || true

  if [ "$purge" = "1" ]; then
    if [ "$assume_yes" != "1" ]; then
      printf 'This will permanently delete the Postgres volume and %s/data. Continue? [y/N] ' "$MUSTER_HOME"
      read -r reply
      case "$reply" in
        y|Y|yes|YES) : ;;
        *) info "Purge cancelled."; exit 0 ;;
      esac
    fi
    info "Dropping Postgres volume..."
    compose down -v || true
    info "Removing $MUSTER_HOME/data..."
    rm -rf "$MUSTER_HOME/data"
  fi

  info "Uninstall complete."
  [ "$purge" = "1" ] || info "Data preserved at $MUSTER_HOME (postgres volume + $MUSTER_HOME/data). Re-run with --purge to remove it."
}

cmd_db() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    shell)
      compose exec postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"
      ;;
    backup)
      local path="${1:-$MUSTER_HOME/backups/muster-$(date +%Y%m%d%H%M%S).sql}"
      mkdir -p "$(dirname "$path")"
      info "Backing up to $path"
      compose exec -T postgres pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB" > "$path"
      info "Backup written to $path"
      ;;
    restore)
      local path="${1:-}"
      [ -n "$path" ] || die "Usage: musterctl db restore <path>"
      [ -f "$path" ] || die "No such file: $path"
      info "Restoring from $path (this may overwrite existing data)"
      compose exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" < "$path"
      info "Restore complete."
      ;;
    *) die "Usage: musterctl db <shell|backup [path]|restore <path>>" ;;
  esac
}

cmd_config() {
  echo "config root:      $MUSTER_HOME"
  echo "app dir:           $APP_DIR"
  echo "venv:               $VENV_DIR"
  echo "compose file:      $COMPOSE_FILE  $( [ -f "$COMPOSE_FILE" ] && echo '(found)' || echo '(MISSING)' )"
  echo "backend port:      $BACKEND_PORT"
  echo "frontend port:     $FRONTEND_PORT"
  echo "postgres port:     $POSTGRES_PORT"
  echo "postgres host:     $POSTGRES_HOST"
  echo "postgres user/db:  $POSTGRES_USER / $POSTGRES_DB"
  echo "os:                $MUSTER_OS"
}

port_in_use() {
  local port="$1"
  if have lsof; then
    lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
  elif have nc; then
    nc -z localhost "$port" >/dev/null 2>&1
  else
    return 1
  fi
}

have() { command -v "$1" >/dev/null 2>&1; }

cmd_doctor() {
  local fail=0
  check() {
    local desc="$1" ok="$2"
    if [ "$ok" = "1" ]; then
      printf '  [PASS] %s\n' "$desc"
    else
      printf '  [FAIL] %s\n' "$desc"
      fail=1
    fi
  }

  echo "Muster doctor"
  echo "--- ports ---"
  if port_in_use "$BACKEND_PORT"; then check "port $BACKEND_PORT (backend) is bound" 1; else check "port $BACKEND_PORT (backend) is bound" 0; fi
  if port_in_use "$FRONTEND_PORT"; then check "port $FRONTEND_PORT (frontend) is bound" 1; else check "port $FRONTEND_PORT (frontend) is bound" 0; fi
  if port_in_use "$POSTGRES_PORT"; then check "port $POSTGRES_PORT (postgres) is bound" 1; else check "port $POSTGRES_PORT (postgres) is bound" 0; fi

  echo "--- install ---"
  if [ -d "$VENV_DIR" ]; then check "venv present at $VENV_DIR" 1; else check "venv present at $VENV_DIR" 0; fi
  if [ -f "$COMPOSE_FILE" ]; then check "compose file present at $COMPOSE_FILE" 1; else check "compose file present at $COMPOSE_FILE" 0; fi

  echo "--- directory bindings ---"
  if [ -f "$MUSTER_HOME/config.json" ]; then
    check "config.json readable" 1
  else
    printf '  [SKIP] no config.json found (no directory bindings configured yet)\n'
  fi

  echo "--- agent CLIs ---"
  if have claude; then check "claude CLI on PATH" 1; else check "claude CLI on PATH" 0; fi
  if have codex; then check "codex CLI on PATH" 1; else check "codex CLI on PATH" 0; fi

  if [ "$fail" -eq 0 ]; then
    info "All checks passed."
  else
    warn "One or more checks failed — see above."
  fi
  return "$fail"
}

cmd_open() {
  local url="http://localhost:${FRONTEND_PORT}"
  if [ "$MUSTER_OS" = "darwin" ]; then
    open "$url"
  else
    xdg-open "$url"
  fi
}

usage() {
  cat <<EOF
Usage: musterctl <command> [args]

Commands:
  install                     Run/re-run the installer (scripts/install.sh)
  start                       Start backend + postgres + frontend
  stop                        Stop backend + postgres + frontend
  restart                     Restart all components
  status                      Show live status of backend, postgres, frontend
  logs [backend|frontend|postgres|all] [-f]
                               Show/follow logs
  upgrade                     Pull latest source, reinstall deps, migrate, restart
                               (no data touched)
  uninstall [--purge] [--yes] Stop + remove services/containers.
                               --purge also drops the postgres volume and
                               ~/.muster/data (prompts unless --yes)
  db shell                     psql shell into the postgres container
  db backup [path]             pg_dump to path (default ~/.muster/backups/...)
  db restore <path>            Restore from a pg_dump file
  config                       Print resolved ports/data dir/postgres info
  doctor                       Check ports, venv, directory bindings, agent CLIs
  open                         Open the frontend URL in your default browser
EOF
}

main() {
  local cmd="${1:-}"
  [ -n "$cmd" ] || { usage; exit 1; }
  shift || true

  case "$cmd" in
    install)   cmd_install "$@" ;;
    start)     cmd_start "$@" ;;
    stop)      cmd_stop "$@" ;;
    restart)   cmd_restart "$@" ;;
    status)    cmd_status "$@" ;;
    logs)      cmd_logs "$@" ;;
    upgrade)   cmd_upgrade "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    db)        cmd_db "$@" ;;
    config)    cmd_config "$@" ;;
    doctor)    cmd_doctor "$@" ;;
    open)      cmd_open "$@" ;;
    -h|--help|help) usage ;;
    *) error "Unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
