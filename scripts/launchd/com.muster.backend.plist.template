<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Muster backend — macOS launchd user agent template.

  scripts/install.sh substitutes placeholders for the installing user's home,
  venv, backend directory/port, service PATH, and Postgres connection values.
  The database settings match ~/.muster/muster.env and the postgres container
  so app/config.py connects with the same values Alembic used.

  Installed to: ~/Library/LaunchAgents/com.muster.backend.plist
  Loaded with:  launchctl load -w ~/Library/LaunchAgents/com.muster.backend.plist
  Logs:         ~/Library/Logs/muster/backend.log (stdout+stderr combined)

  "Pragmatic simplification" (see docs/SPEC.md CLI/install contract, and
  docs/OPERATIONS.md): the PRD originally called for a single cross-compiled
  binary supervised by the OS service manager. Muster's backend is Python/
  FastAPI, so instead we point launchd at `uvicorn` running inside a
  dedicated venv. KeepAlive + RunAtLoad give us the same "always running,
  restarts on crash, starts on login" behavior a compiled binary would get.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.muster.backend</string>

  <key>ProgramArguments</key>
  <array>
    <string>__VENV__/bin/uvicorn</string>
    <string>app.main:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>__BACKEND_PORT__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__BACKEND_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>MUSTER_POSTGRES_HOST</key>
    <string>__PG_HOST__</string>
    <key>MUSTER_POSTGRES_PORT</key>
    <string>__PG_PORT__</string>
    <key>MUSTER_POSTGRES_USER</key>
    <string>__PG_USER__</string>
    <key>MUSTER_POSTGRES_PASSWORD</key>
    <string>__PG_PASSWORD__</string>
    <key>MUSTER_POSTGRES_DB</key>
    <string>__PG_DB__</string>
    <key>MUSTER_INTERACTIVE_TERMINAL_ENABLED</key>
    <string>__TERMINAL_ENABLED__</string>
    <key>MUSTER_DEFAULT_TASK_RUNTIME_MODE</key>
    <string>__DEFAULT_RUNTIME_MODE__</string>
    <key>MUSTER_TERMINAL_ALLOWED_ORIGINS</key>
    <string>__TERMINAL_ORIGINS__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/muster/backend.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/muster/backend.log</string>
</dict>
</plist>
