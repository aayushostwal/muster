# Muster backend — Linux systemd USER unit template.
#
# scripts/install.sh substitutes placeholders for the installing user's home,
# venv, backend directory/port, service PATH, and Postgres connection values.
# The database values match those used by Alembic and the Postgres container.
#
# Installed to: ~/.config/systemd/user/muster.service
# Enabled with: systemctl --user enable --now muster.service
# Logs:         journalctl --user -u muster -f (no explicit log path needed)
#
# "Pragmatic simplification" (see docs/SPEC.md CLI/install contract, and
# docs/OPERATIONS.md): rather than a cross-compiled single binary, the
# "native service" here is `uvicorn` inside a dedicated venv, supervised by
# a systemd --user unit. Restart=on-failure + WantedBy=default.target give
# us auto-restart and start-on-login parity with a compiled-binary install.

[Unit]
Description=Muster backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory="__BACKEND_DIR__"
Environment="HOME=__HOME__"
Environment="PATH=__PATH__"
Environment="MUSTER_POSTGRES_HOST=__PG_HOST__"
Environment="MUSTER_POSTGRES_PORT=__PG_PORT__"
Environment="MUSTER_POSTGRES_USER=__PG_USER__"
Environment="MUSTER_POSTGRES_PASSWORD=__PG_PASSWORD__"
Environment="MUSTER_POSTGRES_DB=__PG_DB__"
ExecStart="__VENV__/bin/uvicorn" app.main:app --host 0.0.0.0 --port __BACKEND_PORT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
